# 复制为 config.env 后填写。值放在此文件，不需要 export。
DASHSCOPE_API_KEY=
# 按 API Key 地域选择：北京使用下方默认地址；新加坡使用
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 申请临时上传凭证的 API 地址，不是自己的 OSS Bucket，也不是视频 URL。
# 使用上述北京/新加坡公共地址时留空即可，脚本自动匹配：
# dashscope.aliyuncs.com -> https://dashscope.aliyuncs.com/api/v1/uploads
# dashscope-intl.aliyuncs.com -> https://dashscope-intl.aliyuncs.com/api/v1/uploads
# 通常无需修改；此项仅保留作高级覆盖，不要猜测其他端点。
# 填写步骤和示例见 README.md 的“模型地址和上传地址怎么填”。
DASHSCOPE_UPLOAD_POLICY_URL=
OMNI_MODEL=qwen3.8-omni-flash
# 默认关闭流式；true/false
STREAM=false
# qwen3.8-omni-flash 的思考强度；none/minimal/low/medium/high/xhigh/max。留空不发送该参数。
REASONING_EFFORT=medium
# 思考模式 + 非流式不支持联网搜索；默认关闭，避免请求冲突
ENABLE_SEARCH=false
SEARCH_STRATEGY=agent
MAX_TOKENS=65536
# 留空表示输出到每个源文件所在目录
OUTPUT_DIR=
# 临时上传和模型请求超时（秒）
UPLOAD_TIMEOUT=60
REQUEST_TIMEOUT=1800

# 服务端视频采样帧率；高动态任务可按需调高至 15，成本相应增加
VIDEO_FPS=2

# 留空使用模型默认值；设置前确认目标模型支持，思考模式下部分采样参数可能不生效
TEMPERATURE=
TOP_P=
# 服务端每帧像素上限，留空遵循服务默认；不是本地压缩
VIDEO_MAX_PIXELS=
